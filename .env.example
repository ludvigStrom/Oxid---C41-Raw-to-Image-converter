# Copy to .env (gitignored) and fill in your values:
#   cp .env.example .env
#
# Store notary credentials once (profile name must match NOTARY_PROFILE):
#   xcrun notarytool store-credentials oxid-notary

# App display name and installer filename slug (Oxid-0.1.0.pkg)
APP_NAME=Oxid
PKG_FILE_BASENAME=Oxid

# Reverse-DNS prefix for the app bundle and installer receipt
PKG_ID_PREFIX=com.example.oxid

# Optional; defaults to PKG_ID_PREFIX
# BUNDLE_ID=com.example.oxid

# Apple Developer Team ID (developer.apple.com → Membership)
TEAM_ID=

# Keychain profile name (not a password)
NOTARY_PROFILE=oxid-notary
